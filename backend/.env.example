# ──────────────────────────────────────────
# GVP Hostel Flavour — Backend Environment
# ──────────────────────────────────────────

NODE_ENV=development
PORT=5000

# MongoDB Atlas Connection (include database name before ?)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?appName=<appName>

# JWT Secret — generate with:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_64_char_hex_secret_here

# Python Analytics Service URL
ANALYTICS_API_URL=http://localhost:8000

# Analytics Service API Key — must match SERVICE_API_KEY in analytics-service/.env
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ANALYTICS_API_SECRET=your_analytics_api_secret_here

# CORS — frontend dev URL
CORS_ORIGIN=http://localhost:5173

# Backend public URL (used by keep-alive cron in production, e.g. Render)
# Leave unset in development — cron will fall back to http://localhost:PORT
# BACKEND_URL=https://your-backend.onrender.com
